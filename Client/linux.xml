<!-- If you want to change mapping, look at /usr/include/X11/keysymdef.h -->
<!-- 1 = the Vita streams input over UDP as soon as it changes (lowest latency, needs Vita app 1.9+), 0 = poll it over TCP. Older Vita apps are polled either way -->
<STREAM_MODE>1</STREAM_MODE>
<!-- 1 = virtual Xbox 360 controller (needs access to /dev/uinput, see README), 0 = keyboard and mouse (X11) -->
<UINPUT_MODE>0</UINPUT_MODE>
<!-- Xbox controller mode: touch corners act as buttons (upper = LB/RB, lower = LS/RS). 1 = on, 0 = off -->
<UINPUT_FRONT_TOUCH>1</UINPUT_FRONT_TOUCH>
<UINPUT_REAR_TOUCH>0</UINPUT_REAR_TOUCH>
<!-- Xbox controller mode: 1 = Vita L/R act as LB/RB and the upper touch corners as LT/RT -->
<UINPUT_SWAP_SHOULDERS>0</UINPUT_SWAP_SHOULDERS>

<KEY_DOWN>0x0053</KEY_DOWN>
<KEY_UP>0x0057</KEY_UP>
<KEY_LEFT>0x0041</KEY_LEFT>
<KEY_RIGHT>0x0044</KEY_RIGHT>
<KEY_CROSS>0x004b</KEY_CROSS>
<KEY_TRIANGLE>0x0049</KEY_TRIANGLE>
<KEY_CIRCLE>0x004c</KEY_CIRCLE>
<KEY_SQUARE>0x004a</KEY_SQUARE>
<KEY_L>0xffe3</KEY_L>
<KEY_R>0x0020</KEY_R>
<KEY_START>0xff0d</KEY_START>
<KEY_SELECT>0xffe1</KEY_SELECT>
<KEY_LANALOG_UP>0xff52</KEY_LANALOG_UP>
<KEY_LANALOG_DOWN>0xff54</KEY_LANALOG_DOWN>
<KEY_LANALOG_LEFT>0xff51</KEY_LANALOG_LEFT>
<KEY_LANALOG_RIGHT>0xff53</KEY_LANALOG_RIGHT>
<KEY_RANALOG_UP>0x0038</KEY_RANALOG_UP>
<KEY_RANALOG_DOWN>0x0032</KEY_RANALOG_DOWN>
<KEY_RANALOG_LEFT>0x0034</KEY_RANALOG_LEFT>
<KEY_RANALOG_RIGHT>0x0036</KEY_RANALOG_RIGHT>
<!-- Optional: keys for L1/R1/L3/R3 (buttons remapped on the Vita, or a PS TV controller). 0x0000 = unmapped -->
<KEY_L1>0x0051</KEY_L1>
<KEY_R1>0x0045</KEY_R1>
<KEY_L3>0x005a</KEY_L3>
<KEY_R3>0x0058</KEY_R3>
<!-- Optional: key for the PS button (when the Vita app sends it to the PC). 0x0000 = unmapped -->
<KEY_PS>0x0000</KEY_PS>
