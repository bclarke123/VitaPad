<!-- If you want to change mapping, look here: http://www.philipstorr.id.au/pcbook/book3/scancode.htm -->

<VIGEM_MODE>0</VIGEM_MODE>
<!-- ViGEm (DualShock 4) touch panels: 0 = unused, 1 = buttons (upper corners L1/R1, lower corners L3/R3), 2 = DS4 touchpad, 3 = DS4 touchpad click -->
<VIGEM_FRONT_TOUCH>1</VIGEM_FRONT_TOUCH>
<VIGEM_REAR_TOUCH>2</VIGEM_REAR_TOUCH>
<!-- ViGEm: 1 = Vita L/R act as L1/R1 and the upper touch corners as L2/R2 -->
<VIGEM_SWAP_SHOULDERS>0</VIGEM_SWAP_SHOULDERS>
<!-- ViGEm: touchpad and motion support, needs ViGEmBus 1.17 or newer. Set to 0 on older drivers -->
<VIGEM_EXTENDED>1</VIGEM_EXTENDED>
<!-- ViGEm: send the Vita gyroscope and accelerometer as DS4 motion -->
<VIGEM_MOTION>1</VIGEM_MOTION>
<VJOY_MODE>0</VJOY_MODE>
<VJOY_ALTERNATE>0</VJOY_ALTERNATE>
<KEY_DOWN>0x1F</KEY_DOWN>
<KEY_UP>0x11</KEY_UP>
<KEY_LEFT>0x1E</KEY_LEFT>
<KEY_RIGHT>0x20</KEY_RIGHT>
<KEY_CROSS>0x25</KEY_CROSS>
<KEY_TRIANGLE>0x17</KEY_TRIANGLE>
<KEY_CIRCLE>0x26</KEY_CIRCLE>
<KEY_SQUARE>0x24</KEY_SQUARE>
<KEY_L>0x1D</KEY_L>
<KEY_R>0x39</KEY_R>
<KEY_START>0x1C</KEY_START>
<KEY_SELECT>0x2A</KEY_SELECT>
<KEY_LANALOG_UP>0x48</KEY_LANALOG_UP>
<KEY_LANALOG_DOWN>0x4B</KEY_LANALOG_DOWN>
<KEY_LANALOG_LEFT>0x4D</KEY_LANALOG_LEFT>
<KEY_LANALOG_RIGHT>0x50</KEY_LANALOG_RIGHT>
<KEY_RANALOG_UP>0x09</KEY_RANALOG_UP>
<KEY_RANALOG_DOWN>0x03</KEY_RANALOG_DOWN>
<KEY_RANALOG_LEFT>0x05</KEY_RANALOG_LEFT>
<KEY_RANALOG_RIGHT>0x07</KEY_RANALOG_RIGHT>